Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: EvoSuite Eclipse plugin - Core
Bundle-SymbolicName: org.evosuite.plugins.eclipse.core;singleton:=true
Bundle-Version: 1.2.1.qualifier
Bundle-Activator: org.evosuite.eclipse.Activator
Bundle-Vendor: EvoSuite
Automatic-Module-Name: org.evosuite.plugins.eclipse.core
Require-Bundle: org.eclipse.core.runtime;bundle-version="3.29.0",
 org.eclipse.core.resources,
 org.eclipse.core.expressions,
 org.eclipse.core.filebuffers,
 org.eclipse.compare,
 org.eclipse.equinox.security,
 org.eclipse.jdt.core,
 org.eclipse.jdt.launching,
 org.eclipse.jdt.junit.core,
 org.eclipse.jdt.ui,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.text,
 org.eclipse.ui,
 org.eclipse.ui.console,
 org.eclipse.ui.ide,
 org.eclipse.ui.workbench.texteditor,
 org.evosuite.plugins.eclipse.deps,
 org.eclipse.m2e.core;resolution:=optional,
 org.eclipse.m2e.maven.runtime;resolution:=optional
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Export-Package: org.evosuite.eclipse,
 org.evosuite.eclipse.classpath,
 org.evosuite.eclipse.handlers,
 org.evosuite.eclipse.launch,
 org.evosuite.eclipse.maven,
 org.evosuite.eclipse.preferences,
 org.evosuite.eclipse.ui
