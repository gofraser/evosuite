<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.commands">
      <command
            id="org.evosuite.eclipse.generateTests"
            name="Generate Tests with EvoSuite"
            description="Generate a JUnit test suite with EvoSuite for the selected classes"
            categoryId="org.eclipse.jdt.ui.category.source">
      </command>
   </extension>

   <extension point="org.eclipse.ui.commandImages">
      <image commandId="org.evosuite.eclipse.generateTests" icon="icons/evosuite.gif"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            class="org.evosuite.eclipse.handlers.GenerateTestsHandler"
            commandId="org.evosuite.eclipse.generateTests">
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <!-- Package Explorer, Project Explorer and outline: classes, packages, source folders, projects. -->
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="org.evosuite.eclipse.generateTests" style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false" operator="or">
                     <adapt type="org.eclipse.jdt.core.IJavaElement">
                        <or>
                           <instanceof value="org.eclipse.jdt.core.ICompilationUnit"/>
                           <instanceof value="org.eclipse.jdt.core.IType"/>
                           <instanceof value="org.eclipse.jdt.core.IPackageFragment"/>
                           <instanceof value="org.eclipse.jdt.core.IPackageFragmentRoot"/>
                           <instanceof value="org.eclipse.jdt.core.IJavaProject"/>
                        </or>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <!-- The Java editor's context menu. -->
      <menuContribution locationURI="popup:#CompilationUnitEditorContext?after=additions">
         <command commandId="org.evosuite.eclipse.generateTests" style="push"/>
      </menuContribution>
      <!-- The main Source menu, for keyboard users. -->
      <menuContribution locationURI="menu:org.eclipse.jdt.ui.source.menu?after=generateGroup">
         <command commandId="org.evosuite.eclipse.generateTests" style="push"/>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="org.evosuite.eclipse.preferences.PreferenceInitializer"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="org.evosuite.eclipse.preferences.EvoSuitePreferencePage"
            category="org.eclipse.jdt.ui.preferences.JavaBasePreferencePage"
            name="EvoSuite"
            class="org.evosuite.eclipse.preferences.EvoSuitePreferencePage">
      </page>
      <page
            id="org.evosuite.eclipse.preferences.LlmPreferencePage"
            category="org.evosuite.eclipse.preferences.EvoSuitePreferencePage"
            name="Large Language Model"
            class="org.evosuite.eclipse.preferences.LlmPreferencePage">
      </page>
      <page
            id="org.evosuite.eclipse.preferences.AdvancedPreferencePage"
            category="org.evosuite.eclipse.preferences.EvoSuitePreferencePage"
            name="Advanced"
            class="org.evosuite.eclipse.preferences.AdvancedPreferencePage">
      </page>
   </extension>

   <!-- The same tree for projects. Each page has the switch for project-specific settings. -->
   <extension point="org.eclipse.ui.propertyPages">
      <page
            id="org.evosuite.eclipse.preferences.EvoSuitePropertyPage"
            name="EvoSuite"
            class="org.evosuite.eclipse.preferences.EvoSuitePropertyPage">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IProject">
               <test property="org.eclipse.core.resources.projectNature" value="org.eclipse.jdt.core.javanature"/>
            </adapt>
         </enabledWhen>
      </page>
      <page
            id="org.evosuite.eclipse.preferences.LlmPropertyPage"
            category="org.evosuite.eclipse.preferences.EvoSuitePropertyPage"
            name="Large Language Model"
            class="org.evosuite.eclipse.preferences.LlmPropertyPage">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IProject">
               <test property="org.eclipse.core.resources.projectNature" value="org.eclipse.jdt.core.javanature"/>
            </adapt>
         </enabledWhen>
      </page>
      <page
            id="org.evosuite.eclipse.preferences.AdvancedPropertyPage"
            category="org.evosuite.eclipse.preferences.EvoSuitePropertyPage"
            name="Advanced"
            class="org.evosuite.eclipse.preferences.AdvancedPropertyPage">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IProject">
               <test property="org.eclipse.core.resources.projectNature" value="org.eclipse.jdt.core.javanature"/>
            </adapt>
         </enabledWhen>
      </page>
   </extension>

   <extension point="org.eclipse.jdt.core.classpathContainerInitializer">
      <classpathContainerInitializer
            id="org.evosuite.eclipse.classpathContainerInitializer"
            class="org.evosuite.eclipse.classpath.EvoSuiteClasspathContainerInitializer">
      </classpathContainerInitializer>
   </extension>

   <extension point="org.eclipse.jdt.ui.classpathContainerPage">
      <classpathContainerPage
            id="org.evosuite.eclipse.classpathContainerInitializer"
            name="EvoSuite Runtime"
            class="org.evosuite.eclipse.classpath.EvoSuiteClasspathContainerPage">
      </classpathContainerPage>
   </extension>

</plugin>
