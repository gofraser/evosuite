<!--
  Exceptions for deliberate behaviours reported by SpotBugs.
-->
<FindBugsFilter>

  <!-- Properties are static but not final == -->
  <Match>
    <Class name="org.evosuite.Properties" />
    <Bug pattern="MS_SHOULD_BE_FINAL" />
  </Match>


  <!-- We use the GC on purpose -->
  <Match>
    <Class name="org.evosuite.utils.ResourceController" />
    <Bug pattern="DM_GC" />
  </Match>
  
  <!-- These constructors mirror the JDK overloads that use the platform charset. -->
  <Match>
    <Or>
      <Class name="org.evosuite.runtime.mock.java.io.MockFileReader" />
      <Class name="org.evosuite.runtime.mock.java.io.MockFileWriter" />
      <Class name="org.evosuite.runtime.mock.java.io.MockPrintWriter" />
    </Or>
    <Method name="&lt;init&gt;" />
    <Bug pattern="DM_DEFAULT_ENCODING" />
  </Match>

  <!-- Array constants keep the identity hash: their concrete array is set after they become map keys. -->
  <Match>
    <Class name="org.evosuite.symbolic.expr.ref.array.ArrayConstant" />
    <Bug pattern="HE_EQUALS_USE_HASHCODE" />
  </Match>

  <!-- The legacy scaffolding list can have been written using the platform charset. -->
  <Match>
    <Class name="org.evosuite.runtime.InitializingListenerUtils" />
    <Method name="~(read|write)InitializationClassList" />
    <Bug pattern="DM_DEFAULT_ENCODING" />
  </Match>

  <!-- The JUnit listener enables the shared runtime settings for the test run. -->
  <Match>
    <Class name="org.evosuite.runtime.InitializingListener" />
    <Method name="testRunStarted" />
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
  </Match>

  <!-- Releasing a lease updates the shared spawn manager under its lock. -->
  <Match>
    <Class name="org.evosuite.maven.util.SpawnProcessManagerLease" />
    <Method name="close" />
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
  </Match>
</FindBugsFilter>
