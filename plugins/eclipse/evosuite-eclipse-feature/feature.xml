   </license>

   <requires>
      <import feature="org.eclipse.jdt" version="3.19.0" match="greaterOrEqual"/>
   </requires>

   <plugin
         id="org.evosuite.plugins.eclipse.deps"
         version="0.0.0"/>

   <plugin
         id="org.evosuite.plugins.eclipse.core"
         version="0.0.0"/>

</feature>
